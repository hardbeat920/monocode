[package]
name = "gpui-pre-apple"
version = "0.3.9"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `gpui_apple` crate (gpui-pre snapshot of zed@93d7456)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "gpui_apple"
zed-version = "0.1.0"
zed-rev = "93d745668805029476e6d7fbb19652116fed51de"

[lib]
path = "src/gpui_apple.rs"
doctest = false
name = "gpui_apple"

[features]
default = []
bench-support = ["gpui/bench-support"]
test-support = ["gpui/test-support"]
runtime_shaders = []
font-kit = [
    "dep:font-kit",
    "dep:core-text",
    "dep:objc2-core-text",
    "dep:pathfinder_geometry",
]

[dependencies]
gpui = { workspace = true }

[target.'cfg(any(target_os = "macos", target_os = "ios"))'.dependencies]
anyhow = { workspace = true }
async-task = { workspace = true }
block2 = { workspace = true }
collections = { workspace = true }
core-foundation = { workspace = true }
core-foundation-sys = { workspace = true }
core-graphics = { workspace = true }
core-text = { workspace = true, optional = true }
derive_more = { workspace = true }
dispatch2 = { workspace = true }
etagere = { workspace = true }
foreign-types = { workspace = true }
futures = { workspace = true }
font-kit = { workspace = true, optional = true, features = ["source"] }
gpui_util = { workspace = true }
image = { workspace = true }
libc = { workspace = true }
log = { workspace = true }
mach2 = { workspace = true }
metal = { workspace = true }
objc2 = { workspace = true }
objc2-core-foundation = { workspace = true, features = ["std", "CFData", "CFDictionary", "CFString", "CFNumber", "CFBase"] }
objc2-core-text = { workspace = true, optional = true }
objc2-core-video = { workspace = true, features = [
    "CVPixelBuffer",
    "CVMetalTexture",
    "CVMetalTextureCache",
    "CVReturn",
    "objc2",
    "objc2-metal",
] }
objc2-metal = { version = "0.3", default-features = false, features = ["MTLDevice", "MTLPixelFormat", "MTLTexture"] }
objc2-foundation = { workspace = true, features = ["NSThread", "NSNotification", "NSOperation", "NSProcessInfo", "block2"] }
objc2-quartz-core = { workspace = true }
objc2-security = { workspace = true }
parking_lot = { workspace = true }
pathfinder_geometry = { workspace = true, optional = true }
smallvec = { workspace = true }
thiserror = { workspace = true }

[target.'cfg(any(target_os = "macos", target_os = "ios"))'.build-dependencies]
cbindgen = { workspace = true }

[lints]
workspace = true
